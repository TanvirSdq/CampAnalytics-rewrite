    "nunjucks": "^3.2.4",
    "plotly.js-dist-min": "^4.1.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nunjucks": "^3.2.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
